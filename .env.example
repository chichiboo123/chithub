# ================================================================
# Chithub 관리자 모드 환경변수 템플릿
# 사용법: 이 파일을 .env.local 로 복사한 뒤 실제 값을 입력하세요.
#   cp .env.example .env.local
#
# ⚠️  보안 주의사항:
#   - .env.local 파일은 절대 git에 커밋하지 마세요 (.gitignore에 포함됨)
#   - VITE_ 변수는 빌드 시 JS 번들에 포함됩니다.
#     공개 저장소에 배포할 때는 민감한 키 값을 넣지 마세요.
#   - GitHub Pages 등 공개 호스팅에서는 번들 파일 검사로 값이 노출될 수 있습니다.
#     개인 로컬 개발/테스트 환경에서만 사용하거나, 권한이 제한된 키를 사용하세요.
#
# 활성화 방법: 앱 우측 하단 모서리를 3초간 꾹 누르기
# ================================================================

VITE_ADMIN_PASSWORD=your_admin_password
VITE_ADMIN_GH_TOKEN=your_github_personal_access_token
VITE_ADMIN_GIST_ID=your_gist_id
VITE_ADMIN_GEMINI_KEY=your_gemini_api_key
